# Firebase Auth 設定（コミット禁止 — .env は .gitignore 済みであること）

# ID トークンの aud / iss 検証に使う Firebase プロジェクト ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# アダプタ切替（DP-007）: firebase | test
#   - 本番 / dev: firebase（未指定時の既定）
#   - test: TestAdapter（Rails.env.test? でも自動的に test 既定）
AUTH_ADAPTER=firebase

# Admin REST 用サービスアカウント鍵の絶対パス（退会削除 / refresh 失効に必要）
# 本番鍵を持たない開発機ではこれを未設定にし、AUTH_ADAPTER=test で回避する
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# ローカル開発で Auth Emulator を使う場合（B-12 / firebase-auth-emulator スキル）
# 設定時は FirebaseAdapter の署名検証スキップ / Admin REST host 切替が必要（同スキル参照）
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
